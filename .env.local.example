# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 加密密钥 (32字节十六进制, 用于加密用户BingX API Key)
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Chart-IX

# BingX
BINGX_API_BASE_URL=https://open-api.bingx.com
# 模拟盘下单/平仓路由 (src/app/api/paper/order, /paper/close) 读的是这个
# NEXT_PUBLIC_ 变量而不是上面那个，两者通常保持同一个值
NEXT_PUBLIC_BINGX_API_BASE_URL=https://open-api.bingx.com

# Sentry (错误监控, 从 sentry.io 项目的 Client Keys (DSN) 页面获取)
NEXT_PUBLIC_SENTRY_DSN=

# Cron (保护 /api/cron/* 路由；Vercel 会自动把这个值当 Bearer token 带在定时任务请求里)
# 生成方式同 ENCRYPTION_KEY: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Web Push（VAPID）。用 `npx web-push generate-vapid-keys` 生成一次。
# 生成后不可更换——更换会使所有存量订阅立即失效。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
